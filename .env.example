# --- Postgres --------------------------------------------------------------
# Raw credentials consumed by the postgres container in docker-compose.prod.yml.
POSTGRES_USER=nexustalent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexustalent
# Full async DSN read by the app. In docker-compose.prod.yml, host must be the
# service name "postgres" (not localhost) so containers resolve it on the network.
DATABASE_URL=postgresql+asyncpg://nexustalent:change-me@postgres:5432/nexustalent

# --- Neo4j -------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
# Host must be the service name "neo4j" in docker-compose.prod.yml.
NEO4J_URI=bolt://neo4j:7687

# --- Qdrant --------------------------------------------------------------------
# Host must be the service name "qdrant" in docker-compose.prod.yml.
QDRANT_URL=http://qdrant:6333

# --- Redis (Celery broker + result backend) -----------------------------------
# Host must be the service name "redis" in docker-compose.prod.yml.
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM providers (ingestion parsing, search extraction/synthesis) ------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- CORS --------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API with credentials.
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# --- Storage ---------------------------------------------------------------
# Path inside the container where uploaded CVs are written (mounted as a volume
# in docker-compose.prod.yml so files survive container restarts).
CV_STORAGE_DIR=storage/cvs
